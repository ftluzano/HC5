# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Turso appointment storage. Keep these server-side; never use VITE_ prefixes.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-a-new-token"

# Clerk authentication.
# Get these values from the Clerk Dashboard.
# Custom signup requires username/password without mandatory email verification or extra required fields.
# Signup profile details are stored as user-editable Clerk unsafe metadata.
CLERK_SECRET_KEY="sk_test_replace-me"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace-me"

# Clerk admin users. Use a comma-separated list of Clerk user IDs or verified email addresses.
ADMIN_UIDS="user_replace-me"
# Alternate variable name supported for Clerk user IDs.
ADMIN_USER_IDS=""
ADMIN_EMAILS="quintinhealthcenter@gmail.com"

# AI support chat API keys are server-side only; do not use VITE_ prefixes.
# OpenRouter is tried first, with Gemini used as a fallback.
OPENROUTER_API_KEY="replace-with-openrouter-key"
OPENROUTER_MODEL="google/gemini-3.8-flash"
GEMINI_API_KEY="replace-with-gemini-key"
GEMINI_MODEL="gemini-3.8-flash"
